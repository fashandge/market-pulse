<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.jianfuchen.market-pulse</string>

    <!-- Run the supervisor via zsh so ~/.zshenv is sourced first (full PATH:
         node/npm in ~/.local/bin, ngrok in /opt/homebrew/bin). -->
    <key>ProgramArguments</key>
    <array>
        <string>/bin/zsh</string>
        <string>-c</string>
        <string>/Users/jianfuchen/projects/market-pulse/src/backend/scripts/ensure_up.sh</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/jianfuchen/projects/market-pulse</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>HOME</key>
        <string>/Users/jianfuchen</string>
    </dict>

    <!-- ensure_up.sh is a long-running daemon: it loops forever, re-checking
         every 60s and restarting whatever is down (crash / wake-from-sleep
         recovery). It must NOT be a one-shot — under launchd, when the job's
         main process exits, launchd kills the whole job including the detached
         servers/tunnel it started. So we keep the supervisor itself alive with
         KeepAlive (NOT StartInterval); the servers live as long as it does. -->
    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <true/>

    <key>StandardOutPath</key>
    <string>/Users/jianfuchen/projects/market-pulse/tmp/launchd.out.log</string>

    <key>StandardErrorPath</key>
    <string>/Users/jianfuchen/projects/market-pulse/tmp/launchd.err.log</string>
</dict>
</plist>
